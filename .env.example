# DineSync Platform — Root Environment Variable Template
# Copy this file to `server/.env` and supply actual values for your deployment.

# -----------------------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. Database Connection
# -----------------------------------------------------------------------------
# MongoDB URI (Atlas or Local). Note: If Atlas connection fails or IP is unwhitelisted,
# the backend automatically falls back to an in-memory replica set for local dev resilience.
MONGO_URI=mongodb://localhost:27017/dinesync_db

# -----------------------------------------------------------------------------
# 3. Security & Authentication
# -----------------------------------------------------------------------------
# Strong secrets for JSON Web Tokens and Cookie Session signing
JWT_SECRET=dinesync_super_secure_jwt_secret_key_2026_change_in_production
SESSION_SECRET=dinesync_session_signing_secret_2026_change_in_production

# -----------------------------------------------------------------------------
# 4. Payment Gateway (Razorpay Standard Checkout INR)
# -----------------------------------------------------------------------------
# Mode: "test" for sandbox/demo, "live" for production transactions
PAYMENT_MODE=test
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder_2026

# -----------------------------------------------------------------------------
# 5. Restaurant Profile & Billing Details (Appears on Tax Invoices & QR Codes)
# -----------------------------------------------------------------------------
RESTAURANT_NAME=DineSync Demo Restaurant
RESTAURANT_GSTIN=29ABCDE1234F1Z5
RESTAURANT_ADDRESS=100 Feet Road, Indiranagar, Bengaluru, Karnataka 560038
RESTAURANT_PHONE=+91 98765 43210
RESTAURANT_EMAIL=contact@dinesync.com
RESTAURANT_TAX_RATE=5.0
